// ================ SENSOR ==================
bool readGasSensor() {
  int raw = digitalRead(GAS_PIN);
  return GAS_ACTIVE_LOW ? (raw == LOW) : (raw == HIGH);
}

// ================ FAN CONTROL =============
// Assumes a two-direction L298N-style H-bridge.
void setFan(bool enabled) {
  if (enabled && gasDetected) {
    enabled = false;
  }

  if (enabled) {
    digitalWrite(IN1_PIN, HIGH);
    digitalWrite(IN2_PIN, LOW);
    digitalWrite(ENA_PIN, HIGH);
  } else {
    digitalWrite(ENA_PIN, LOW);
    digitalWrite(IN1_PIN, LOW);
    digitalWrite(IN2_PIN, LOW);
  }

  fanOn = enabled;
}

// ================ API =====================
void sendStatus() {
  String json = "{";
  json += "\"gasDetected\":";
  json += gasDetected ? "true" : "false";
  json += ",\"fanOn\":";
  json += fanOn ? "true" : "false";
  json += ",\"wifi\":";
  json += (WiFi.status() == WL_CONNECTED) ? "true" : "false";
  json += ",\"uptime\":";
  json += String((millis() - bootMillis) / 1000UL);
  json += "}";

  server.sendHeader("Cache-Control", "no-store");
  server.send(200, "application/json", json);
}

void handleFan() {
  if (!server.hasArg("state")) {
    server.send(400, "application/json",
                "{\"ok\":false,\"message\":\"Missing state\"}");
    return;
  }

  String state = server.arg("state");
  state.toLowerCase();

  if (state == "on") {
    // Refresh sensor before accepting an ON command.
    gasDetected = readGasSensor();

    if (gasDetected) {
      setFan(false);
      server.send(409, "application/json",
        "{\"ok\":false,\"message\":\"Gas alert active. Fan ON blocked.\"}");
      return;
    }

    setFan(true);
    server.send(200, "application/json",
      "{\"ok\":true,\"message\":\"Fan command accepted\"}");
    return;
  }

  if (state == "off") {
    setFan(false);
    server.send(200, "application/json",
      "{\"ok\":true,\"message\":\"Fan switched off\"}");
    return;
  }

  server.send(400, "application/json",
              "{\"ok\":false,\"message\":\"Use on or off\"}");
}

// ================ SETUP ===================
void setup() {
  Serial.begin(115200);
  bootMillis = millis();

  pinMode(GAS_PIN, INPUT);
  pinMode(ENA_PIN, OUTPUT);
  pinMode(IN1_PIN, OUTPUT);
  pinMode(IN2_PIN, OUTPUT);

  // Keep the fan disabled during startup.
  digitalWrite(ENA_PIN, LOW);
  digitalWrite(IN1_PIN, LOW);
  digitalWrite(IN2_PIN, LOW);

  gasDetected = readGasSensor();

  WiFi.mode(WIFI_STA);
  WiFi.begin(WIFI_SSID, WIFI_PASSWORD);
  Serial.print("\nConnecting to Wi-Fi");

  unsigned long start = millis();
  while (WiFi.status() != WL_CONNECTED &&
         millis() - start < 20000UL) {
    delay(300);
    Serial.print(".");
  }

  if (WiFi.status() == WL_CONNECTED) {
    Serial.println("\nWi-Fi connected!");
    Serial.print("Dashboard: http://");
    Serial.println(WiFi.localIP());
  } else {
    Serial.println("\nWi-Fi connection failed.");
    Serial.println("Check SSID/password and restart.");
  }

  server.on("/", HTTP_GET, []() {
    server.send_P(200, "text/html", PAGE);
  });

  server.on("/api/status", HTTP_GET, sendStatus);
  server.on("/api/fan", HTTP_POST, handleFan);

  server.onNotFound([]() {
    server.send(404, "text/plain", "Not found");
  });

  server.begin();
  Serial.println("Web server started.");
}

// ================ LOOP ====================
void loop() {
  server.handleClient();

  if (millis() - lastSensorRead >= 200UL) {
    lastSensorRead = millis();
    gasDetected = readGasSensor();

    // Stop the fan if a gas alert appears.
    // Do not automatically restart it when the alert clears.
    if (gasDetected && fanOn) {
      setFan(false);
      Serial.println("GAS ALERT: fan output disabled.");
    }
  }

  yield();
}
